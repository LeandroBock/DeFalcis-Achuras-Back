# Backend para la verificación con teclado del frontend (npm run test:keyboard).
# Usa el Postgres descartable de docker-compose.test.yml: NUNCA la base real.
# Son valores de prueba, no secretos.
PORT=3995
NODE_ENV=development
DB_HOST=localhost
