# Aplicación
NODE_ENV=
PORT=
CORS_ORIGINS=
SWAGGER_ENABLED=

# Base de datos
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_SSL=

# Autenticación
JWT_SECRET=
# Duración máxima de una sesión en horas (por defecto 8). El cierre por
# inactividad (60 minutos) lo hace la app.
SESSION_HOURS=

# Super admin inicial (opcional: solo se crea si no existe)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# ARCA / AFIP
# Para probar sin certificado: CUIT 20409378472 con ARCA_PRODUCTION=false y
# ARCA_CERT_PATH / ARCA_KEY_PATH vacías.
# Con ARCA_PRODUCTION=true la app no arranca si falta algún dato obligatorio
# (CUIT, punto de venta, certificado, clave, token y datos del emisor) o si no
# existen los archivos del certificado.
ARCA_CUIT=
ARCA_CERT_PATH=
ARCA_KEY_PATH=
ARCA_PRODUCTION=
ARCA_PTO_VTA=
AFIPSDK_ACCESS_TOKEN=

# Datos fiscales para el PDF de factura
ARCA_BUSINESS_NAME=
ARCA_BUSINESS_ADDRESS=
ARCA_IVA_CONDITION=
ARCA_IIBB=
ARCA_ACTIVITY_START=

# WhatsApp (conexión por QR, como WhatsApp Web)
# true solo en el servidor de producción: dos servidores con la misma sesión
# se pisan entre sí. En local dejala vacía o en false.
WHATSAPP_ENABLED=

# Teléfonos que reciben un WhatsApp cada vez que un repartidor entrega (o no
# puede entregar) una nota. Separados por coma. Requiere WhatsApp conectado.
DELIVERY_NOTIFY_PHONES=
